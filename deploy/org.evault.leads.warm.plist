<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>org.evault.leads.warm</string>
  <key>ProgramArguments</key>
  <array>
    <string>/usr/bin/curl</string>
    <string>-fsS</string>
    <string>--max-time</string>
    <string>30</string>
    <string>-X</string>
    <string>POST</string>
    <string>http://127.0.0.1:3040/api/leads/warm</string>
  </array>
  <key>StartInterval</key>
  <integer>180</integer>
  <key>RunAtLoad</key>
  <true/>
  <key>StandardOutPath</key>
  <string>/tmp/evault-leads-warm.out.log</string>
  <key>StandardErrorPath</key>
  <string>/tmp/evault-leads-warm.err.log</string>
</dict>
</plist>
