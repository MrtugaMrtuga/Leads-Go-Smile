# Mini only. Never expose the secret to the browser.
PORT=3040
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT/exec
APPS_SCRIPT_SECRET=REPLACE_WITH_SECRET
# Refill the Apps Script list cache (action=leads&fresh=1) so Actualizar can hit CacheService.
# 0 disables. Default 120000 (2 min). The cache itself lasts 180s.
# LEADS_WARM_MS=120000
# LEADS_WARM_ACTION=leads
# LEADS_WARM_ACTION=ping   # wake /exec only; does not read the sheet
