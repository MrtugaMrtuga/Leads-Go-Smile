# Mini only. Never expose the secret to the browser.
PORT=3040
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT/exec
APPS_SCRIPT_SECRET=REPLACE_WITH_SECRET
# Wake /exec with action=ping so a cold start stays rare. Ping does not read the sheet.
# 0 disables. Default 180000 (3 min). The list cache itself lasts 60s.
# LEADS_WARM_MS=180000
# LEADS_WARM_ACTION=ping
# LEADS_WARM_ACTION=leads   # also send fresh=1 and refill CacheService
# Carla (geral@gosmile.pt) is MailApp in the bound Apps Script. No Gmail key here.
